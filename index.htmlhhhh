<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Sunny Game — Merge & Trade</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: #1e2a1f;
            margin: 0;
            padding: 16px;
            color: #f5e7d9;
            min-height: 100vh;
        }

        .npc-card {
            background: #2c3e2a;
            border-radius: 28px;
            padding: 14px 16px;
            margin-bottom: 20px;
            text-align: center;
            border: 1px solid #ffd966;
            box-shadow: 0 6px 12px rgba(0,0,0,0.3);
        }

        .npc-name {
            font-size: 20px;
            font-weight: bold;
            color: #ffd966;
        }

        .npc-wants {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 8px;
            flex-wrap: wrap;
        }

        .want-item {
            background: #3e5a3b;
            padding: 4px 12px;
            border-radius: 40px;
            font-size: 13px;
            font-weight: 500;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 20px;
            background: #2a3a27;
            padding: 12px;
            border-radius: 28px;
        }

        .cell {
            aspect-ratio: 1 / 1;
            background: #3a2e28;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            cursor: pointer;
            transition: 0.07s linear;
            border: 2px solid #6b4e3a;
            box-shadow: 0 3px 6px black;
            font-weight: 500;
        }

        .cell.selected {
            border: 3px solid #ffb347;
            background: #5e4b3a;
            transform: scale(0.97);
        }

        .info-panel {
            background: #2c2b26;
            border-radius: 28px;
            padding: 12px 16px;
            margin-bottom: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .coins {
            background: #ffd966;
            color: #2c2b26;
            padding: 8px 20px;
            border-radius: 60px;
            font-weight: bold;
            font-size: 18px;
        }

        .buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 8px;
            margin-bottom: 12px;
        }

        button {
            background: #5e7c5a;
            border: none;
            color: white;
            padding: 10px 16px;
            border-radius: 60px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.08s linear;
            font-family: inherit;
        }

        button:active {
            transform: scale(0.95);
            background: #3e5a3b;
        }

        .sell-btn {
            background: #b86f2c;
        }

        .reset-btn {
            background: #5a3e2e;
        }

        .footer-note {
            text-align: center;
            font-size: 11px;
            margin-top: 18px;
            opacity: 0.6;
        }
    </style>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
</head>
<body>

<div class="npc-card">
    <div class="npc-name">🧙 Волшебник Мерлин</div>
    <div class="npc-wants">
        <span class="want-item">⚔️ Меч → 100 🪙</span>
        <span class="want-item">🧪 Зелье → 50 🪙</span>
        <span class="want-item">📜 Свиток → 30 🪙</span>
    </div>
</div>

<div class="grid" id="grid"></div>

<div class="info-panel">
    <span>🔮 Соединяй одинаковые предметы</span>
    <span class="coins" id="coinsDisplay">💰 50</span>
</div>

<div class="buttons">
    <button id="craftMaterialsBtn">🌿 Материалы</button>
    <button id="craftFoodBtn">🍎 Еда</button>
    <button id="craftArmorBtn">🛡️ Броня</button>
    <button id="craftWeaponBtn">⚔️ Оружие</button>
    <button id="craftPotionBtn">🧪 Зелья</button>
</div>

<div class="buttons">
    <button id="sellToNpcBtn" class="sell-btn">💎 Продать NPC (из сетки)</button>
    <button id="resetGameBtn" class="reset-btn">🔄 Сброс игры</button>
</div>
<div class="footer-note">
    ⚡ Кликни на предмет → кликни на такой же → соединятся!
</div>

<script>
    const tg = window.Telegram.WebApp;
    tg.ready();
    tg.expand();

    // ---------- ВСЕ ПРЕДМЕТЫ ----------
    const itemsDB = {
        "trava": { name: "🌿 Трава", price: 1, level: 1, type: "material" },
        "brevno": { name: "🪵 Бревно", price: 2, level: 2, type: "material" },
        "kamen": { name: "Камень", price: 5, level: 3, type: "material" },
        "zhelezo": { name: "⛏️ Железо", price: 10, level: 4, type: "material" },
        "sok": { name: "🧃 Сок", price: 8, level: 2, type: "food" },
        "hleb": { name: "🍞 Хлеб", price: 15, level: 3, type: "food" },
        "mech": { name: "⚔️ Меч", price: 100, level: 5, type: "weapon" },
        "zelie": { name: "🧪 Зелье", price: 50, level: 4, type: "potion" },
        "svitok": { name: "📜 Свиток", price: 30, level: 3, type: "scroll" }
    };

    const itemIds = ["trava", "brevno", "kamen", "zhelezo", "sok", "hleb", "mech", "zelie", "svitok"];

    // ПРАВИЛА СЛИЯНИЯ (одинаковые → новый предмет)
    const mergeRules = {
        "trava": "brevno",
        "brevno": "kamen",
        "kamen": "zhelezo",
        "zhelezo": "mech",
        "sok": "hleb",
        "hleb": "zelie"
    };

    // ---------- НАЧАЛЬНАЯ СЕТКА 4x4 ----------
    let grid = [
        "trava", "trava", "brevno", "kamen",
        "sok", "trava", "brevno", "zhelezo",
        "kamen", "sok", "trava", "brevno",
        "zhelezo", "mech", "zelie", "svitok"
    ];

    let coins = 80;
    let selectedIndex = null;

    // ---------- СОХРАНЕНИЕ ----------
    function saveGame() {
        localStorage.setItem("sunnyGrid", JSON.stringify(grid));
        localStorage.setItem("sunnyCoins", coins);
    }

    function loadGame() {
        const savedGrid = localStorage.getItem("sunnyGrid");
        const savedCoins = localStorage.getItem("sunnyCoins");
        if (savedGrid) grid = JSON.parse(savedGrid);
        if (savedCoins) coins = parseInt(savedCoins);
        renderAll();
    }

    // ---------- ОТРИСОВКА ----------
    function renderAll() {
        renderGrid();
        document.getElementById("coinsDisplay").innerHTML = `💰 ${coins}`;
    }

    function renderGrid() {
        const container = document.getElementById("grid");
        container.innerHTML = "";
        for (let i = 0; i < grid.length; i++) {
            const itemKey = grid[i];
            const display = itemsDB[itemKey]?.name || "❓";
            const cell = document.createElement("div");
            cell.className = "cell";
            if (selectedIndex === i) cell.classList.add("selected");
            cell.textContent = display;
            cell.onclick = (function(idx) { return function() { onCellClick(idx); }; })(i);
            container.appendChild(cell);
        }
    }

    // ---------- ЛОГИКА СОЕДИНЕНИЯ ----------
    function tryMerge(itemKey) {
        if (!mergeRules[itemKey]) return null;
        return mergeRules[itemKey];
    }

    function onCellClick(index) {
        if (selectedIndex === null) {
            // выделяем ячейку
            selectedIndex = index;
            renderGrid();
            return;
        }

        const firstIdx = selectedIndex;
        const secondIdx = index;
        selectedIndex = null;

        if (firstIdx === secondIdx) {
            renderGrid();
            return;
        }

        const firstItem = grid[firstIdx];
        const secondItem = grid[secondIdx];

        if (!firstItem || !secondItem) {
            renderGrid();
            return;
        }

        // проверяем: одинаковые и есть правило слияния
        if (firstItem === secondItem && mergeRules[firstItem]) {
            const newItem = mergeRules[firstItem];
            grid[firstIdx] = newItem;
            grid[secondIdx] = newItem;
            // бонус за соединение
            coins += 2;
            saveGame();
            renderAll();
            tg.impactFeedback?.(tg.ImpactFeedbackStyle.LIGHT);
        } else {
            renderGrid();
        }
    }

    // ---------- КРАФТ: добавить предмет в ПЕРВУЮ СВОБОДНУЮ ЯЧЕЙКУ ----------
    function addItemToFirstEmptyCell(itemId, cost) {
        if (coins < cost) {
            tg.showPopup({ title: "Нет монет", message: `Нужно ${cost} монет`, buttons: [{type: "ok"}] });
            return false;
        }

        const emptyIndex = grid.findIndex(cell => cell === null || cell === undefined);
        if (emptyIndex === -1) {
            tg.showPopup({ title: "Сетка полна", message: "Соедини предметы, чтобы освободить место", buttons: [{type: "ok"}] });
            return false;
        }

        coins -= cost;
        grid[emptyIndex] = itemId;
        saveGame();
        renderAll();
        tg.impactFeedback?.(tg.ImpactFeedbackStyle.MEDIUM);
        return true;
    }

    // ---------- ПРОДАЖА NPC (ищет предметы в сетке) ----------
    function sellToNpc() {
        let soldSomething = false;
        const npcBuys = { "mech": 100, "zelie": 50, "svitok": 30 };

        for (let i = 0; i < grid.length; i++) {
            const item = grid[i];
            if (npcBuys[item]) {
                const price = npcBuys[item];
                coins += price;
                grid[i] = null; // очищаем ячейку
                soldSomething = true;
            }
        }

        if (soldSomething) {
            saveGame();
            renderAll();
            tg.showPopup({ title: "✅ Продано!", message: "NPC купил редкие предметы", buttons: [{type: "ok"}] });
        } else {
            tg.showPopup({ title: "Нет товара", message: "У тебя в сетке нет Меча, Зелья или Свитка", buttons: [{type: "ok"}] });
        }
    }

    // ---------- СБРОС ----------
    function resetGame() {
        grid = [
            "trava", "trava", "brevno", "kamen",
            "sok", "trava", "brevno", "zhelezo",
            "kamen", "sok", "trava", "brevno",
            "zhelezo", "mech", "zelie", "svitok"
        ];
        coins = 80;
        selectedIndex = null;
        saveGame();
        renderAll();
        tg.showPopup({ title: "🔄 Сброс", message: "Игра перезапущена", buttons: [{type: "ok"}] });
    }

    // ---------- ПРИВЯЗКА КНОПОК ----------
    document.getElementById("craftMaterialsBtn").onclick = () => addItemToFirstEmptyCell("trava", 2);
    document.getElementById("craftFoodBtn").onclick = () => addItemToFirstEmptyCell("sok", 4);
    document.getElementById("craftArmorBtn").onclick = () => addItemToFirstEmptyCell("kamen", 6);
    document.getElementById("craftWeaponBtn").onclick = () => addItemToFirstEmptyCell("mech", 25);
    document.getElementById("craftPotionBtn").onclick = () => addItemToFirstEmptyCell("zelie", 18);
    document.getElementById("sellToNpcBtn").onclick = () => sellToNpc();
    document.getElementById("resetGameBtn").onclick = () => resetGame();

    loadGame();
</script>
</body>
</html>
